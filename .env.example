# A Meta USER access token, not a Page token. This server exchanges it for
# per-Page tokens via /me/accounts, because a comment read through a user token
# comes back as an empty array rather than an error — observed against live
# Graph, not read off the documentation. See docs/publish-actions-error.md for
# the write-side twin of the same mistake, which fails loudly instead.
META_ACCESS_TOKEN=your-user-access-token-here

# Write tools (respond_to_comment, moderate_comment) are not registered unless
# this is exactly "true". Reading needs nothing set.
FACEBOOK_ENGAGEMENT_ENABLE_WRITES=false

# Live integration tests. Both default off; writes need BOTH set.
# META_INTEGRATION_TESTS=true
# META_INTEGRATION_WRITE_TESTS=true
# META_INTEGRATION_PAGE_ID=
# META_INTEGRATION_COMMENT_ID=

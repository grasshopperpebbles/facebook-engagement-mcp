{
  "name": "no-author-anywhere-needs-reply",
  "rule": "With no author on any comment and a known Page, nothing identifies the Page, so nothing may be called answered \u2014 and the answer must NOT claim to know why the authors are missing.",
  "why": "T-39 for the behaviour, T-45 for the wording. The fallback read `replies.length > 0 ? answered : needs_reply` \u2014 'somebody replied, so it is handled' \u2014 which inverted the answer exactly when the Page was behind on everything. The FIRST fix carried a reason that was overturned within the day (T-38 said Graph withholds `from` for people and returns it for Pages; T-42 showed the token was the variable), and that reason shipped in two strings a marketer reads. The behaviour survived its justification, so this case asserts the behaviour AND forbids the claim.",
  "tool": "comment_activity",
  "arguments": {
    "page": "pg1",
    "filter": "all",
    "groupBy": "post"
  },
  "graph": {
    "/me/accounts": {
      "data": [
        {
          "id": "pg1",
          "name": "Test Page",
          "access_token": "page-token",
          "tasks": [
            "MODERATE",
            "MANAGE"
          ]
        }
      ]
    },
    "/pg1/feed": {
      "data": [
        {
          "id": "pg1_p1",
          "message": "post",
          "created_time": "2026-09-01T09:00:00+0000",
          "is_published": true
        }
      ],
      "paging": {
        "cursors": {
          "before": "b",
          "after": "a"
        }
      }
    },
    "/pg1_p1/comments": {
      "data": [
        {
          "id": "anon1",
          "message": "Anyone from the shop here?",
          "created_time": "2026-09-02T10:00:00+0000",
          "comment_count": 1,
          "is_hidden": false,
          "can_comment": true,
          "can_hide": true
        }
      ],
      "paging": {
        "cursors": {
          "before": "b",
          "after": "a"
        }
      }
    },
    "/anon1/comments": {
      "data": [
        {
          "id": "anon1_r",
          "message": "I had the same problem.",
          "created_time": "2026-09-02T11:00:00+0000",
          "comment_count": 0,
          "is_hidden": false,
          "can_comment": true,
          "can_hide": true
        }
      ],
      "paging": {
        "cursors": {
          "before": "b",
          "after": "a"
        }
      }
    }
  },
  "expect": {
    "threadStatuses": {
      "anon1": "needs_reply"
    },
    "at": {
      "statusBasis": "reply_count"
    },
    "notMatches": [
      "written by a person",
      "withholds it for comments",
      "the Page has not replied to anything",
      "(authored|written) by (a|an) (individual|human|user)",
      "(withholds|omits|hides) (it|author|authorship)[^.]{0,30}for",
      "(person|individual|human)s? (wrote|authored) (it|the comment|them)"
    ],
    "matches": [
      "over-report|already be handled",
      "depends? on the credential"
    ]
  }
}

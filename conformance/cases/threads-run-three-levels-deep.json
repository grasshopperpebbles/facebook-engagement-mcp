{
  "name": "threads-run-three-levels-deep",
  "rule": "A reply to a reply is a real comment, and `parent` points at the REPLY, not at the top-level comment. The sweep must follow the third level.",
  "why": "T-11, 2026-09-11. Both this server and the comment console were built on a doc comment asserting the opposite as settled fact — 'Facebook flattens a reply-to-a-reply under the top-level comment'. Nobody had watched it. The sweep called replies() only on top-level comments, so a visitor's answer to the Page's reply was never fetched.",
  "tool": "comment_activity",
  "arguments": { "page": "pg1", "filter": "all", "groupBy": "post" },
  "graph": {
    "/me/accounts": {
      "data": [
        { "id": "pg1", "name": "Test Page", "access_token": "page-token", "tasks": ["MODERATE", "MANAGE"] }
      ]
    },
    "/pg1/feed": {
      "data": [
        { "id": "pg1_p1", "message": "post", "created_time": "2026-09-01T09:00:00+0000", "is_published": true }
      ],
      "paging": { "cursors": { "before": "b", "after": "a" } }
    },
    "/pg1_p1/comments": {
      "data": [
        {
          "id": "c1",
          "message": "Do you ship to Ireland?",
          "created_time": "2026-09-02T10:00:00+0000",
          "from": { "id": "visitor", "name": "A Customer" },
          "comment_count": 1,
          "is_hidden": false,
          "can_comment": true,
          "can_hide": true
        }
      ],
      "paging": { "cursors": { "before": "b", "after": "a" } }
    },
    "/c1/comments": {
      "data": [
        {
          "id": "c1_r1",
          "message": "We do!",
          "created_time": "2026-09-02T11:00:00+0000",
          "from": { "id": "pg1", "name": "Test Page" },
          "comment_count": 1,
          "is_hidden": false,
          "can_comment": true,
          "can_hide": false
        }
      ],
      "paging": { "cursors": { "before": "b", "after": "a" } }
    },
    "/c1_r1/comments": {
      "data": [
        {
          "id": "c1_r1_r1",
          "message": "How much is postage?",
          "created_time": "2026-09-02T12:00:00+0000",
          "from": { "id": "visitor", "name": "A Customer" },
          "comment_count": 0,
          "is_hidden": false,
          "can_comment": true,
          "can_hide": true
        }
      ],
      "paging": { "cursors": { "before": "b", "after": "a" } }
    }
  },
  "expect": {
    "requested": ["/c1_r1/comments"],
    "threadStatuses": { "c1": "needs_reply" },
    "at": { "statusBasis": "author_identity" },
    "matches": ["How much is postage"]
  }
}
